<idea-plugin>
    <id>com.touchkiss.pastetomd</id>
    <name>Paste to Markdown</name>
    <vendor email="touchkiss@foxmail.com">touchkiss</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.intellij.plugins.markdown</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Paste to Markdown" displayType="BALLOON" isLogByDefault="true"/>
        <projectService serviceImplementation="com.touchkiss.pastetomd.settings.PasteToMarkdownSettings"/>
        <projectConfigurable
                parentId="editor"
                instance="com.touchkiss.pastetomd.settings.PasteToMarkdownConfigurable"
                id="com.touchkiss.pastetomd.settings"
                displayName="Paste to Markdown"/>
    </extensions>

    <extensions defaultExtensionNs="org.intellij.markdown">
        <browserPreviewExtensionProvider implementation="com.touchkiss.pastetomd.preview.MarkdownPreviewCopyExtension$Provider"/>
    </extensions>

    <actions>
        <action id="PasteToMarkdown.CopyPreviewForFeishu"
                class="com.touchkiss.pastetomd.actions.CopyMarkdownPreviewForFeishuAction"
                text="Copy Markdown Preview for Feishu"
                description="Copy the Markdown preview selection with ace-table classes on HTML tables">
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="ctrl meta C"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="ctrl meta C"/>
        </action>
        <action id="PasteToMarkdown.PasteOriginal"
                class="com.touchkiss.pastetomd.actions.PasteOriginalAction"
                text="Paste as Original"
                description="Paste clipboard text without converting rich text to Markdown"/>
        <action id="PasteToMarkdown.ReconvertClipboard"
                class="com.touchkiss.pastetomd.actions.ReconvertClipboardAction"
                text="Paste as Markdown"
                description="Convert the current clipboard content to Markdown and paste it into the editor">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl meta V"/>
        </action>
        <action id="PasteToMarkdown.ShowClipboardSource"
                class="com.touchkiss.pastetomd.actions.ShowClipboardSourceAction"
                text="Show Clipboard Rich Text Source"
                description="Display clipboard HTML, RTF, and plain text source for debugging"/>
    </actions>
</idea-plugin>
